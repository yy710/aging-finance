{
  "name": "aging-finance-static-site",
  "version": "1.0.0",
  "private": true,
  "description": "养老金融主题静态展示网站及管理后台",
  "type": "commonjs",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "init-db": "node scripts/init-db.js",
    "generate": "node scripts/generate.js --public-base-path /af",
    "generate:root": "node scripts/generate.js",
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "multer": "2.2.0",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "supertest": "7.2.2"
  }
}
