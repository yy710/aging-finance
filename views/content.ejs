<%
  const contentSite = (typeof site !== 'undefined' && site) || (typeof settings !== 'undefined' && settings) || {};
  const contentPage = (typeof page !== 'undefined' && page) || {};
  const contentPublicUrl = typeof publicUrl === 'function' ? publicUrl : (typeof asset === 'function' ? asset : (value) => value);
  const contentParentUrl = contentPublicUrl((typeof parentUrl === 'string' && parentUrl) || contentPage.parent_url || (contentPage.parent && contentPage.parent.url) || '/');
  const explicitTheme = `${contentPage.theme || contentPage.background_image || ''}`.trim().toLowerCase();
  const themeSource = `${contentPage.decorative_character || ''} ${contentPage.slug || ''} ${contentPage.title || ''}`.toLowerCase();
  let contentTheme = ['hui', 'yi', 'yang', 'le', 'chuan'].includes(explicitTheme) ? explicitTheme : 'hui';
  if (!explicitTheme) {
    if (themeSource.includes('医') || /(^|[\s/_-])yi($|[\s/_-])/u.test(themeSource)) contentTheme = 'yi';
    else if (themeSource.includes('养') || /(^|[\s/_-])yang($|[\s/_-])/u.test(themeSource)) contentTheme = 'yang';
    else if (themeSource.includes('乐') || /(^|[\s/_-])le($|[\s/_-])/u.test(themeSource)) contentTheme = 'le';
    else if (themeSource.includes('传') || /(^|[\s/_-])chuan($|[\s/_-])/u.test(themeSource)) contentTheme = 'chuan';
  }
  const suppliedSafeContent = typeof safeContent !== 'undefined' ? safeContent : (typeof contentHtml !== 'undefined' ? contentHtml : (contentPage.safe_content || contentPage.content_html || contentPage.content || ''));
  const plainContent = suppliedSafeContent ? '' : (contentPage.plain_content || '');
  const contentImage = contentPage.content_image || contentPage.image_path || '';
  const pdfUrl = contentPage.pdf_url || contentPage.pdfUrl || '';
%>
<!doctype html>
<html lang="zh-CN">
<%- include('partials/head', { site: contentSite, page: contentPage, publicUrl: contentPublicUrl, publicBasePath: typeof publicBasePath === 'string' ? publicBasePath : '' }) %>
<body class="public-site template-content theme-<%= contentTheme %>">
  <a class="skip-link" href="#main-content">跳至主要内容</a>
  <div class="page-canvas">
    <%- include('partials/page-background', { page: contentPage, theme: contentTheme, publicUrl: contentPublicUrl }) %>
    <%- include('partials/header', { page: contentPage, parentUrl: contentParentUrl, publicUrl: contentPublicUrl }) %>
    <main class="page-main content-main" id="main-content">
      <article class="content-panel">
        <% if (contentImage) { %><img class="content-panel__image" src="<%= contentPublicUrl(contentImage) %>" alt="<%= contentPage.image_alt || contentPage.title || '' %>" decoding="async"><% } %>
        <% if (suppliedSafeContent) { %><div class="rich-content"><%- suppliedSafeContent %></div><% } %>
        <% if (plainContent) { %><div class="rich-content rich-content--plain"><%= plainContent %></div><% } %>
        <% if (pdfUrl) { %><p class="content-panel__document"><a href="<%= contentPublicUrl(pdfUrl) %>" target="_blank" rel="noopener noreferrer"><%= contentPage.pdf_label || contentPage.title || '查看文档' %></a></p><% } %>
      </article>
    </main>
    <%- include('partials/footer', { site: contentSite, page: contentPage, theme: contentTheme, publicUrl: contentPublicUrl }) %>
  </div>
</body>
</html>
