<%
  const backgroundPage = (typeof page !== 'undefined' && page) || {};
  const backgroundPublicUrl = typeof publicUrl === 'function' ? publicUrl : (typeof asset === 'function' ? asset : (value) => value);
  const backgroundTheme = typeof theme === 'string' && theme ? theme : 'hui';
  const topDecorations = {
    home: '/assets/images/decor/home-top.png',
    hui: '/assets/images/decor/hui-top.png',
    yi: '/assets/images/decor/yi-top.png',
    yang: '/assets/images/decor/yang-top.png',
    le: '/assets/images/decor/le-top.png',
    chuan: '/assets/images/decor/chuan-top.png',
  };
  const bottomDecorations = {
    home: '/assets/images/decor/home-bottom.png',
    hui: '/assets/images/decor/hui-bottom.png',
    yi: '/assets/images/decor/yi-bottom.png',
    yang: '/assets/images/decor/yang-bottom.png',
    le: '/assets/images/decor/le-bottom.png',
    chuan: '/assets/images/decor/chuan-bottom.png',
  };
  const configuredValue = backgroundPage.top_decoration_image || backgroundPage.background_top_image || backgroundPage.background_image || '';
  const configuredTop = String(configuredValue).startsWith('/')
    ? configuredValue
    : (topDecorations[configuredValue] || '');
  const topDecoration = configuredTop || topDecorations[backgroundTheme] || topDecorations.hui;
  const configuredBottomValue = backgroundPage.bottom_decoration_image || backgroundPage.background_bottom_image || '';
  const configuredBottom = String(configuredBottomValue).startsWith('/')
    ? configuredBottomValue
    : (bottomDecorations[configuredBottomValue] || '');
  const bottomDecoration = configuredBottom || bottomDecorations[backgroundTheme] || bottomDecorations.hui;
%>
<div class="page-background" aria-hidden="true">
  <img class="page-background__top" src="<%= backgroundPublicUrl(topDecoration) %>" alt="" width="720" height="480" fetchpriority="high">
  <div class="page-background__columns"></div>
  <img class="page-background__bottom" src="<%= backgroundPublicUrl(bottomDecoration) %>" alt="" width="720" height="504" decoding="async">
</div>
