<%
  const backAsset = typeof asset === 'function' ? asset : (value) => value;
  const backHref = (typeof parentUrl === 'string' && parentUrl) || '/';
%>
<a class="back-button" href="<%= backHref %>" data-back-button data-parent-url="<%= backHref %>" aria-label="返回上一级页面">
  <img src="<%= backAsset('/assets/images/global/back.png') %>" alt="" width="92" height="93">
</a>
