# 将本段合并到 www.all2key.cn 已有的 server 块中。
# Node 只监听 127.0.0.1:3100；不要向公网开放 3100 端口。

location = /af {
    return 301 /af/;
}

# proxy_pass 末尾的 / 会在转发前删除外部 /af/ 前缀：
# /af/admin/ -> Express /admin/
# /af/assets/css/site.css -> Express /assets/css/site.css
location ^~ /af/ {
    client_max_body_size 6m;

    proxy_pass http://127.0.0.1:3100/;
    proxy_http_version 1.1;
    proxy_redirect off;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /af;
}
